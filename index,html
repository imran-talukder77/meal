<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Mess Manager</title>

    <link
        rel="stylesheet"
        href="./style.css"
    >

</head>


<body>


    <!-- ========================================
         AUTH
    ======================================== -->

    <div
        class="auth-container"
        id="authContainer"
    >


        <!-- LOGIN -->

        <div
            class="auth-box"
            id="loginBox"
        >

            <div class="logo">
                🍚
            </div>

            <h1>
                Mess Manager
            </h1>

            <p class="subtitle">
                Login to your mess account
            </p>


            <form id="loginForm">

                <div class="input-group">

                    <label>Email</label>

                    <input
                        type="email"
                        id="loginEmail"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Password</label>

                    <input
                        type="password"
                        id="loginPassword"
                        placeholder="Enter your password"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="auth-btn"
                >
                    Login
                </button>

            </form>


            <p class="switch-text">

                Don't have an account?

                <button
                    type="button"
                    id="showRegister"
                    class="switch-btn"
                >
                    Create Account
                </button>

            </p>

        </div>



        <!-- REGISTER -->

        <div
            class="auth-box hidden"
            id="registerBox"
        >

            <div class="logo">
                🍚
            </div>

            <h1>
                Create Account
            </h1>

            <p class="subtitle">
                Join your mess
            </p>


            <form id="registerForm">

                <div class="input-group">

                    <label>Name</label>

                    <input
                        type="text"
                        id="registerName"
                        placeholder="Enter your name"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Email</label>

                    <input
                        type="email"
                        id="registerEmail"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Password</label>

                    <input
                        type="password"
                        id="registerPassword"
                        placeholder="Minimum 6 characters"
                        minlength="6"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="auth-btn"
                >
                    Create Account
                </button>

            </form>


            <p class="switch-text">

                Already have an account?

                <button
                    type="button"
                    id="showLogin"
                    class="switch-btn"
                >
                    Login
                </button>

            </p>

        </div>

    </div>



    <!-- ========================================
         DASHBOARD
    ======================================== -->

    <div
        id="dashboard"
        class="dashboard hidden"
    >


        <!-- HEADER -->

        <header class="dashboard-header">

            <div>

                <h1>
                    🍚 Mess Manager
                </h1>

                <p id="welcomeText">
                    Welcome
                </p>

            </div>


            <div class="header-right">

                <span
                    id="roleBadge"
                    class="role-badge"
                >
                    Member
                </span>


                <button
                    id="logoutBtn"
                    class="logout-btn"
                >
                    Logout
                </button>

            </div>

        </header>



        <!-- ========================================
             STAT CARDS
        ======================================== -->

        <section class="dashboard-cards">


            <div class="dashboard-card">

                <span>👥</span>

                <h3>
                    Total Members
                </h3>

                <strong id="totalMembers">
                    0
                </strong>

            </div>


            <div class="dashboard-card">

                <span>🍚</span>

                <h3>
                    Total Meals
                </h3>

                <strong id="totalMeals">
                    0
                </strong>

            </div>


            <div class="dashboard-card">

                <span>💰</span>

                <h3>
                    Total Bazar
                </h3>

                <strong id="totalBazar">
                    ৳0
                </strong>

            </div>


            <div class="dashboard-card">

                <span>📊</span>

                <h3>
                    Meal Rate
                </h3>

                <strong id="mealRate">
                    ৳0
                </strong>

            </div>

        </section>



        <!-- ========================================
             MANAGER CONTROL
        ======================================== -->

        <section
            id="managerSection"
            class="manager-section hidden"
        >

            <div class="section-title">

                <div>

                    <h2>
                        👑 Manager Control
                    </h2>

                    <p>
                        Manage your mess members
                    </p>

                </div>

            </div>


            <div
                id="membersList"
                class="members-list"
            >

                <!-- Members load here -->

            </div>

        </section>



        <!-- ========================================
             MEMBER AREA
        ======================================== -->

        <section class="coming-section">

            <div class="coming-icon">
                🍚
            </div>

            <h2>
                Meal & Bazar Management
            </h2>

            <p>
                Meal, bazar, deposit and balance
                system will appear here.
            </p>

        </section>

    </div>



    <!-- ========================================
         CUSTOM MODAL
    ======================================== -->

    <div
        id="customModal"
        class="modal-overlay hidden"
    >

        <div class="modal-box">

            <div
                id="modalIcon"
                class="modal-icon"
            >
                ⚠️
            </div>


            <h3 id="modalTitle">
                Confirm
            </h3>


            <p id="modalMessage">
                Are you sure?
            </p>


            <div class="modal-actions">

                <button
                    id="modalCancel"
                    class="modal-cancel"
                >
                    Cancel
                </button>


                <button
                    id="modalConfirm"
                    class="modal-confirm"
                >
                    Confirm
                </button>

            </div>

        </div>

    </div>



    <script
        type="module"
        src="./app.js"
    ></script>

</body>

</html>