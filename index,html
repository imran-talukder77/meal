<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mess Manager</title>

    <link rel="stylesheet" href="./style.css">

</head>


<body>


    <!-- ========================================
         AUTH
    ======================================== -->

    <div class="auth-container" id="authContainer">


        <!-- LOGIN -->

        <div class="auth-box" id="loginBox">

            <div class="logo">
                🍚
            </div>

            <h1>
                Mess Manager
            </h1>

            <p class="subtitle">
                Login to your mess account
            </p>


            <form id="loginForm">

                <div class="input-group">

                    <label>Email</label>

                    <input type="email" id="loginEmail" placeholder="Enter your email" required>

                </div>


                <div class="input-group">

                    <label>Password</label>

                    <input type="password" id="loginPassword" placeholder="Enter your password" required>

                </div>


                <button type="submit" class="auth-btn">
                    Login
                </button>

            </form>


            <p class="switch-text">

                Don't have an account?

                <button type="button" id="showRegister" class="switch-btn">
                    Create Account
                </button>

            </p>

        </div>



        <!-- REGISTER -->

        <div class="auth-box hidden" id="registerBox">

            <div class="logo">
                🍚
            </div>

            <h1>
                Create Account
            </h1>

            <p class="subtitle">
                Join your mess
            </p>


            <form id="registerForm">

                <div class="input-group">

                    <label>Name</label>

                    <input type="text" id="registerName" placeholder="Enter your name" required>

                </div>


                <div class="input-group">

                    <label>Email</label>

                    <input type="email" id="registerEmail" placeholder="Enter your email" required>

                </div>


                <div class="input-group">

                    <label>Password</label>

                    <input type="password" id="registerPassword" placeholder="Minimum 6 characters" minlength="6"
                        required>

                </div>


                <button type="submit" class="auth-btn">
                    Create Account
                </button>

            </form>


            <p class="switch-text">

                Already have an account?

                <button type="button" id="showLogin" class="switch-btn">
                    Login
                </button>

            </p>

        </div>

    </div>



    <!-- ========================================
         DASHBOARD
    ======================================== -->

    <div id="dashboard" class="dashboard hidden">


        <!-- HEADER -->

        <header class="dashboard-header">

            <div>

                <h1>
                    🍚 Mess Manager
                </h1>

                <p id="welcomeText">
                    Welcome
                </p>

            </div>


            <div class="header-right">

                <span id="roleBadge" class="role-badge">
                    Member
                </span>


                <button id="logoutBtn" class="logout-btn">
                    Logout
                </button>

            </div>

        </header>



        <!-- ========================================
             STAT CARDS
        ======================================== -->

        <section class="dashboard-cards">


            <div class="dashboard-card">

                <span>👥</span>

                <h3>
                    Total Members
                </h3>

                <strong id="totalMembers">
                    0
                </strong>

            </div>


            <div class="dashboard-card">

                <span>🍚</span>

                <h3>
                    Total Meals
                </h3>

                <strong id="totalMeals">
                    0
                </strong>

            </div>


            <div class="dashboard-card">

                <span>💰</span>

                <h3>
                    Total Bazar
                </h3>

                <strong id="totalBazar">
                    ৳0
                </strong>

            </div>


            <div class="dashboard-card">

                <span>📊</span>

                <h3>
                    Meal Rate
                </h3>

                <strong id="mealRate">
                    ৳0
                </strong>

            </div>

        </section>



        <!-- ========================================
             MANAGER CONTROL
        ======================================== -->

        <section id="managerSection" class="manager-section hidden">

            <div class="section-title">

                <div>

                    <h2>
                        👑 Manager Control
                    </h2>

                    <p>
                        Manage your mess members
                    </p>

                </div>

            </div>


            <div id="membersList" class="members-list">

                <!-- Members load here -->

            </div>

        </section>

        <!-- ========================================
     DAILY MEAL
======================================== -->

        <section class="meal-section">

            <div class="section-title">

                <div>

                    <h2>
                        🍚 Daily Meal
                    </h2>

                    <p>
                        Manage daily meals of all members
                    </p>

                </div>

            </div>


            <!-- DATE SELECTOR -->

            <div class="meal-date-box">

                <label for="mealDate">
                    📅 Select Date
                </label>

                <input type="date" id="mealDate">

            </div>


            <!-- MEAL LIST -->

            <div id="dailyMealList" class="daily-meal-list">

                <p class="meal-loading">
                    Loading meals...
                </p>

            </div>

        </section>

    </div>





    <!-- ========================================
     MONTHLY ACCOUNTING
======================================== -->

    <section class="accounting-section">

        <div class="section-title">

            <div>
                <h2>📊 Monthly Accounting</h2>

                <p>
                    Bazar, deposit, meal rate and balance
                </p>
            </div>

        </div>


        <!-- MONTH SELECT -->

        <div class="accounting-filter">

            <label for="accountingMonth">
                📅 Select Month
            </label>

            <input type="month" id="accountingMonth">

        </div>


        <!-- SUMMARY -->

        <div class="accounting-summary">

            <div class="account-summary-card">
                <span>🍚</span>

                <small>Total Meals</small>

                <strong id="monthTotalMeals">
                    0
                </strong>
            </div>


            <div class="account-summary-card">
                <span>💰</span>

                <small>Total Bazar</small>

                <strong id="monthTotalBazar">
                    ৳0
                </strong>
            </div>


            <div class="account-summary-card">
                <span>📊</span>

                <small>Meal Rate</small>

                <strong id="monthMealRate">
                    ৳0
                </strong>
            </div>


            <div class="account-summary-card">
                <span>💵</span>

                <small>Total Deposit</small>

                <strong id="monthTotalDeposit">
                    ৳0
                </strong>
            </div>

        </div>


        <!-- BAZAR -->

        <div class="account-block">

            <div class="account-block-header">

                <div>
                    <h3>💰 Bazar</h3>

                    <p>
                        All monthly bazar records
                    </p>
                </div>

            </div>


            <!-- MANAGER ADD BAZAR -->

            <div id="bazarFormBox" class="manager-form-box hidden">

                <input type="date" id="bazarDate">

                <input type="number" id="bazarAmount" placeholder="Amount ৳" min="1">

                <input type="text" id="bazarDescription" placeholder="Description">

                <button id="addBazarBtn" class="primary-action-btn">
                    + Add Bazar
                </button>

            </div>


            <div id="bazarList" class="account-list">

                <p class="account-loading">
                    Loading bazar...
                </p>

            </div>

        </div>


        <!-- DEPOSIT -->

        <div class="account-block">

            <div class="account-block-header">

                <div>
                    <h3>💵 Deposit</h3>

                    <p>
                        Members' deposited money
                    </p>
                </div>

            </div>


            <!-- MANAGER ADD DEPOSIT -->

            <div id="depositFormBox" class="manager-form-box hidden">

                <select id="depositUser">

                    <option value="">
                        Select Member
                    </option>

                </select>


                <input type="date" id="depositDate">

                <input type="number" id="depositAmount" placeholder="Amount ৳" min="1">

                <button id="addDepositBtn" class="primary-action-btn">
                    + Add Deposit
                </button>

            </div>


            <div id="depositList" class="account-list">

                <p class="account-loading">
                    Loading deposits...
                </p>

            </div>

        </div>


        <!-- MEMBER BALANCE -->

        <div class="account-block">

            <div class="account-block-header">

                <div>
                    <h3>🧮 Member Balance</h3>

                    <p>
                        Monthly individual হিসাব
                    </p>
                </div>

            </div>


            <div id="balanceList" class="balance-list">

                <p class="account-loading">
                    Calculating balance...
                </p>

            </div>

        </div>

    </section>



    <!-- ========================================
         CUSTOM MODAL
    ======================================== -->

    <div id="customModal" class="modal-overlay hidden">

        <div class="modal-box">

            <div id="modalIcon" class="modal-icon">
                ⚠️
            </div>


            <h3 id="modalTitle">
                Confirm
            </h3>


            <p id="modalMessage">
                Are you sure?
            </p>


            <div class="modal-actions">

                <button id="modalCancel" class="modal-cancel">
                    Cancel
                </button>


                <button id="modalConfirm" class="modal-confirm">
                    Confirm
                </button>

            </div>

        </div>

    </div>



    <script type="module" src="./app.js"></script>

</body>

</html>